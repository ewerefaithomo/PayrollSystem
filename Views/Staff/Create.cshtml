    @section Scripts {
        <script>
            window.onload = function () {
                const gradeLevel = document.getElementById("GradeLevel");

                if (gradeLevel) {
                    gradeLevel.addEventListener("change", function () {
                        let selectedGrade = this.value;

                        if (typeof salaryStructure !== 'undefined') {
                            let data = salaryStructure[selectedGrade];

                            if (data) {
                                document.getElementById("Consolidated").value = data.Consolidated;
                                document.getElementById("Allowance").value = data.Allowance;
                                document.getElementById("TeachingAllowance").value = data.TeachingAllowance;
                                document.getElementById("SpecialistAllowance").value = data.SpecialistAllowance;
                                document.getElementById("RoralPostingAllowance").value = data.RuralPostingAllowance;
                                document.getElementById("HazardAllowance").value = data.HazardAllowance;
                            }
                        }
                    });
                }

                var field = "@ViewBag.ErrorField";

                if (field === "StaffID") {
                    document.getElementById("StaffID").focus();
                }

                if (field === "FileNo") {
                    document.getElementById("FileNo").focus();
                }
            };
        </script>
    }

</body>
