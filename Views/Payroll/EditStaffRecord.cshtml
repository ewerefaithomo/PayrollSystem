                <div class="form-group"><label asp-for="ConmessNonClinicalAllowance">Conmess Non Clinical Allowance</label><input asp-for="ConmessNonClinicalAllowance" type="number" step="0.01" /></div>
                <div class="form-group"><label asp-for="PharmacistConsultAllowance">Pharmacist Consult Allowance</label><input asp-for="PharmacistConsultAllowance" type="number" step="0.01" /></div>
                <div class="form-group"><label asp-for="Arrears">Arrears</label><input asp-for="Arrears" type="number" step="0.01" /></div>
                <div class="form-group"><label asp-for="Refund">Refund</label><input asp-for="Refund" type="number" step="0.01" /></div>
            </div>

            <!-- DEDUCTIONS -->
            <div class="section-header">Deductions</div>
            <div class="form-grid">
                <div class="form-group"><label asp-for="OverPaymentDeduction">Over Payment Deduction</label><input asp-for="OverPaymentDeduction" type="number" step="0.01" /></div>
                <div class="form-group"><label asp-for="Pension">Pension</label><input asp-for="Pension" type="number" step="0.01" /></div>
                <div class="form-group"><label asp-for="Tax">Tax</label><input asp-for="Tax" type="number" step="0.01" /></div>
                <div class="form-group"><label asp-for="TAX_ARREARS">Tax Arrears</label><input asp-for="TAX_ARREARS" type="number" step="0.01" /></div>
                <div class="form-group"><label asp-for="AMLSN">AMLSN</label><input asp-for="AMLSN" type="number" step="0.01" /></div>
                <div class="form-group"><label asp-for="NMA_DUES">NMA Dues</label><input asp-for="NMA_DUES" type="number" step="0.01" /></div>
                <div class="form-group"><label asp-for="NMA_SPECIAL_LEVY">NMA Special Levy</label><input asp-for="NMA_SPECIAL_LEVY" type="number" step="0.01" /></div>
                <div class="form-group"><label asp-for="MEDCAN_DUES">MEDCAN Dues</label><input asp-for="MEDCAN_DUES" type="number" step="0.01" /></div>
                <div class="form-group"><label asp-for="ARD">ARD</label><input asp-for="ARD" type="number" step="0.01" /></div>
                <div class="form-group"><label asp-for="NARD">NARD</label><input asp-for="NARD" type="number" step="0.01" /></div>
                <div class="form-group"><label asp-for="RENT">Rent</label><input asp-for="RENT" type="number" step="0.01" /></div>
                <div class="form-group"><label asp-for="RENT_ARREARS">Rent Arrears</label><input asp-for="RENT_ARREARS" type="number" step="0.01" /></div>
            </div>

            <!-- BANK DETAILS -->
            <div class="section-header">Bank Details</div>
            <div class="form-grid">

                <!-- BANK NAME COMBOBOX -->
                <div class="form-group">
                    <label asp-for="Bank_Name">Bank Name</label>
                    <input asp-for="Bank_Name" list="bankList" placeholder="Select or type Bank Name..." />
                    <datalist id="bankList">
                        <option value="ACCESS BANK PLC"></option>
                        <option value="CITIBANK NIGERIA LIMITED"></option>
                        <option value="ECOBANK NIGERIA PLC"></option>
                        <option value="FIDELITY BANK PLC"></option>
                        <option value="FIRST BANK OF NIGERIA LIMITED"></option>
                        <option value="FIRST CITY MONUMENT BANK (FCMB)"></option>
                        <option value="GLOBUS BANK LIMITED"></option>
                        <option value="GUARANTY TRUST BANK (GTBANK)"></option>
                        <option value="JAIZ BANK PLC"></option>
                        <option value="KEYSTONE BANK LIMITED"></option>
                        <option value="POLARIS BANK PLC"></option>
                        <option value="PROVIDUS BANK LIMITED"></option>
                        <option value="STANBIC IBTC BANK PLC"></option>
                        <option value="STANDARD CHARTERED BANK NIGERIA"></option>
                        <option value="STERLING BANK PLC"></option>
                        <option value="SUNTRUST BANK"></option>
                        <option value="TAJ BANK"></option>
                        <option value="TITAN TRUST BANK LIMITED"></option>
                        <option value="UNION BANK OF NIGERIA PLC"></option>
                        <option value="UNITED BANK FOR AFRICA (UBA)"></option>
                        <option value="UNITY BANK PLC"></option>
                        <option value="WEMA BANK PLC"></option>
                        <option value="ZENITH BANK PLC"></option>
                    </datalist>
                </div>

                <div class="form-group">
                    <label asp-for="Bank_Branch">Bank Branch</label>
                    <input asp-for="Bank_Branch" />
                </div>
                <div class="form-group">
                    <label asp-for="Account_Number">Account Number</label>
                    <input asp-for="Account_Number" />
                </div>
            </div>

            <!-- BUTTONS -->
            <div class="button-group">
                <button type="submit" class="btn-update">Update Record</button>
                <a asp-controller="Payroll" asp-action="Update" class="btn-search">Search Another Record</a>
                <a asp-controller="Account" asp-action="Dashboard" class="btn-dashboard">Back to Dashboard</a>
            </div>

        </form>
    </div>

    <!-- =========================================
         FOOTER
    ========================================= -->

    <div class="footer">
        UNIVERSITY OF BENIN TEACHING HOSPITAL &copy; @DateTime.Now.Year Payroll Management System
    </div>

</body>
</html>